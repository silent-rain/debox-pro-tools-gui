{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-open",
    "log:default",
    "fs:default",
    "fs:allow-create",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-appdata-write",
    "fs:allow-appdata-write-recursive",
    "fs:allow-download-write",
    "fs:allow-download-write-recursive",
    "websocket:default",
    "http:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    "dialog:default",
    "os:default"
  ]
}